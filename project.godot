; Godot 4.6 — prototype OpenXR Quest 3
config_version=5

[application]
config/name="Webs • Liberty VR"
config/icon="res://icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Prototype de déplacement VR. Carte Liberty City à importer séparément."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.3, 0.48, 0.62, 1)

[xr]
openxr/enabled=true
openxr/default_action_map="res://config/openxr_action_map.tres"
openxr/environment_blend_mode=0
openxr/extensions/hand_tracking=false
shaders/enabled=true

[physics]
common/physics_ticks_per_second=72
